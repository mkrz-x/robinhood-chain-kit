{
  "name": "robinhood-chain-kit",
  "version": "0.5.0",
  "description": "Oracle Guard, chain constants, bridge contracts, market sessions, and resilient RPC helpers for Robinhood Chain (chain id 4663).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "check:package": "publint && attw --pack . && npm run check:packed",
    "check:packed": "node scripts/check-packed.mjs",
    "check:examples": "npm --prefix examples run check",
    "check:live": "npm run build && node scripts/verify-live.mjs",
    "test": "vitest run",
    "verify": "npm run check:types && npm run build && npm test && npm run check:package && npm run check:examples",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "publint": "^0.3.22",
    "tsup": "^8.5.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mkrz-x/robinhood-chain-kit.git"
  },
  "homepage": "https://github.com/mkrz-x/robinhood-chain-kit#readme",
  "bugs": {
    "url": "https://github.com/mkrz-x/robinhood-chain-kit/issues"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "keywords": [
    "robinhood-chain",
    "arbitrum-orbit",
    "4663",
    "tokenized-stocks",
    "evm",
    "viem",
    "getlogs",
    "indexer",
    "oracle-guard",
    "chainlink",
    "price-feeds"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    }
  }
}
