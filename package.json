{
  "name": "robinhood-chain-kit",
  "version": "0.9.0",
  "description": "ERC-8056 scaled-UI stock tokens, peer-to-peer settlement, transaction preflight, Oracle Guard, chain constants, and resilient RPC helpers for Robinhood Chain (chain id 4663).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/viem.ts src/entry-erc8056.ts src/entry-oracle.ts src/entry-preflight.ts --format esm,cjs --dts --sourcemap --clean",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "check:package": "publint && attw --pack . && npm run check:packed",
    "check:packed": "node scripts/check-packed.mjs",
    "check:examples": "npm --prefix examples run check",
    "check:live": "npm run build && node scripts/verify-live.mjs",
    "test": "vitest run",
    "verify": "npm run check:types && npm run build && npm test && npm run check:package && npm run check:examples",
    "release": "node scripts/preflight-release.mjs && npm run verify && npm publish",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "viem": "^2.21.0"
  },
  "peerDependenciesMeta": {
    "viem": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "publint": "^0.3.22",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2",
    "viem": "^2.55.10",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mkrz-x/robinhood-chain-kit.git"
  },
  "homepage": "https://github.com/mkrz-x/robinhood-chain-kit#readme",
  "bugs": {
    "url": "https://github.com/mkrz-x/robinhood-chain-kit/issues"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "keywords": [
    "robinhood-chain",
    "arbitrum-orbit",
    "4663",
    "tokenized-stocks",
    "evm",
    "viem",
    "getlogs",
    "indexer",
    "oracle-guard",
    "chainlink",
    "price-feeds",
    "transaction-preflight",
    "transaction-simulation",
    "action-planner",
    "erc-8056",
    "erc8056",
    "tokenized-equities",
    "corporate-actions",
    "stock-tokens",
    "settlement",
    "delivery-versus-payment",
    "viem-extension",
    "usdg",
    "oracle",
    "uniswap-v4",
    "mcp",
    "agentic"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./viem": {
      "import": {
        "types": "./dist/viem.d.ts",
        "default": "./dist/viem.js"
      },
      "require": {
        "types": "./dist/viem.d.cts",
        "default": "./dist/viem.cjs"
      },
      "default": "./dist/viem.js"
    },
    "./erc8056": {
      "import": {
        "types": "./dist/entry-erc8056.d.ts",
        "default": "./dist/entry-erc8056.js"
      },
      "require": {
        "types": "./dist/entry-erc8056.d.cts",
        "default": "./dist/entry-erc8056.cjs"
      },
      "default": "./dist/entry-erc8056.js"
    },
    "./oracle": {
      "import": {
        "types": "./dist/entry-oracle.d.ts",
        "default": "./dist/entry-oracle.js"
      },
      "require": {
        "types": "./dist/entry-oracle.d.cts",
        "default": "./dist/entry-oracle.cjs"
      },
      "default": "./dist/entry-oracle.js"
    },
    "./preflight": {
      "import": {
        "types": "./dist/entry-preflight.d.ts",
        "default": "./dist/entry-preflight.js"
      },
      "require": {
        "types": "./dist/entry-preflight.d.cts",
        "default": "./dist/entry-preflight.cjs"
      },
      "default": "./dist/entry-preflight.js"
    }
  }
}
